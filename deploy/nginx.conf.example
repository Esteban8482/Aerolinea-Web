# Ejemplo para integración futura, incluido dentro del contexto http de nginx.conf.
# Requiere DNS, certificados, red privada y staticfiles preparados por integración.
server {
    listen 80;
    server_name api.example.invalid;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name api.example.invalid;
    ssl_certificate /etc/nginx/tls/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    access_log off;
    error_log /dev/stderr crit;

    location /static/ {
        alias /srv/aerolinea/static/;
    }

    location / {
        proxy_pass http://backend:8000;
        proxy_set_header Host $host;
        # Sobrescribir cabeceras externas; habilitar DJANGO_TRUST_PROXY solo en red privada.
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
    }
}
