# Desarrollo: completa los dos valores vacíos antes de ejecutar Compose.
# Generación segura local: consulta backend/README.md. No usar este archivo directamente.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB=aerolinea
POSTGRES_USER=aerolinea
POSTGRES_PASSWORD=
BACKEND_PORT=8000
POSTGRES_PORT=5432
DJANGO_CSRF_TRUSTED_ORIGINS=
# Solo backend local en WSL: usuario/clave/base de arriba; clave con codificación URI.
# Compose configura estas URL automáticamente con el host db.
# DATABASE_URL=postgresql://aerolinea:REEMPLAZAR@127.0.0.1:5432/aerolinea
# TEST_DATABASE_URL=postgresql://aerolinea:REEMPLAZAR@127.0.0.1:5432/test_aerolinea
# Producción (no se carga .env automáticamente):
# DJANGO_SETTINGS_MODULE=config.settings.production
# DJANGO_ALLOWED_HOSTS=api.example.invalid
# DJANGO_CSRF_TRUSTED_ORIGINS=https://api.example.invalid
# DJANGO_SECURE_HSTS_SECONDS=3600
# DJANGO_TRUST_PROXY=false
# EMAIL_HOST=smtp.example.invalid
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# EMAIL_USE_SSL=false
# DEFAULT_FROM_EMAIL=no-reply@example.invalid
