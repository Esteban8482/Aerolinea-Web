# Desarrollo: completa los dos valores vacíos antes de ejecutar Compose.
# Generación segura local: consulta backend/README.md. No usar este archivo directamente.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB=aerolinea
POSTGRES_USER=aerolinea
POSTGRES_PASSWORD=
BACKEND_PORT=8000
POSTGRES_PORT=5432
DJANGO_CSRF_TRUSTED_ORIGINS=
# HU-007: URL de pantalla de verificación sin query/fragmento.
EMAIL_VERIFICATION_FRONTEND_URL=
# Solo desarrollo: referencia expresamente de prueba, sin política legal aprobada.
REGISTRATION_POLICY_REFERENCE=DOCUMENTO-DE-PRUEBA
REGISTRATION_POLICY_VERSION=test-v1
REGISTRATION_POLICY_URL=http://localhost:8000/api/v1/auth/registration-policy/test-document/
# HU-007 requiere salida HTTPS a api.pwnedpasswords.com:443 y DNS funcional.
# Destino fijo y espera total 3 s en código; sin API key, corpus ni variables de fallback.
# Backend directamente en WSL: configurar almacenamiento privado local ignorado por Git.
# PRIVATE_MEDIA_ROOT=/ruta/privada/imagenes
# REGISTRATION_TRUSTED_PROXIES=127.0.0.1
# Producción mantiene el registro deshabilitado por defecto. Solo tras aprobación documental:
# REGISTRATION_POLICY_APPROVED=false
# REGISTRATION_POLICY_IS_TEST=true
# Solo backend local en WSL: usuario/clave/base de arriba; clave con codificación URI.
# Compose configura estas URL automáticamente con el host db.
# DATABASE_URL=postgresql://aerolinea:REEMPLAZAR@127.0.0.1:5432/aerolinea
# TEST_DATABASE_URL=postgresql://aerolinea:REEMPLAZAR@127.0.0.1:5432/test_aerolinea
# Producción (no se carga .env automáticamente):
# DJANGO_SETTINGS_MODULE=config.settings.production
# DJANGO_ALLOWED_HOSTS=api.example.invalid
# DJANGO_CSRF_TRUSTED_ORIGINS=https://api.example.invalid
# DJANGO_SECURE_HSTS_SECONDS=3600
# DJANGO_TRUST_PROXY=false
# EMAIL_HOST=smtp.example.invalid
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# EMAIL_USE_SSL=false
# DEFAULT_FROM_EMAIL=no-reply@example.invalid
